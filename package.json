{
  "name": "qr-studio",
  "version": "1.0.0",
  "private": true,
  "description": "QR Studio — personal QR code generator and manager (PWA)",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun --bun eslint .",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun --bun vitest run --project unit",
    "test:integration": "bun --bun vitest run --project integration",
    "test:e2e": "bun --bun playwright test",
    "test:all": "bun run typecheck && bun run lint && bun run test && bun run test:integration && bun run test:e2e",
    "redis:test": "docker run -d --rm --name qr-test-redis -p 6390:6379 redis:7-alpine",
    "restore": "bun scripts/restore.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.2.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "qr-code-styling": "^1.9.2",
    "qrcode-generator": "^1.5.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "redis": "^6.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "happy-dom": "^21.0.4",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "packageManager": "bun@1.4.2"
}
