# QR Studio - environment template.
#
# Copy to .env.local for local development (`cp .env.example .env.local`) and set the same names
# in Vercel -> Project -> Settings -> Environment Variables for production.
# .env.local is git-ignored. NEVER commit real values. Every value below is a placeholder.
#
# See docs/SETUP.md (local) and docs/DEPLOYMENT.md (Vercel) for the full procedure.

# ---------------------------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------------------------
# Redis connection string. Redis Cloud Free has NO TLS, so use redis:// (NOT rediss://).
#   Local disposable Redis (bun run redis:test):  redis://localhost:6390
#   Redis Cloud:                                  redis://default:<password>@<host>:<port>
# Shared with the research site is fine: QR Studio only uses keys starting with "qr:v1:".
# (Alias also read by the code: QR_REDIS_URL, used only if REDIS_URL is empty.)
REDIS_URL=redis://localhost:6390

# ---------------------------------------------------------------------------------------------
# Public base URL (required)
# ---------------------------------------------------------------------------------------------
# Origin of the deployed app, no trailing slash. It is encoded into dynamic QR codes (<origin>/r/<slug>),
# used for the CSRF origin check and to block links that point back at this app.
# NEXT_PUBLIC_* is inlined into the browser bundle at BUILD time: redeploy after changing it.
#   Local:      http://localhost:3000
#   Production: https://qr.zeyuyaoy.com
# (Alias also read by server code: APP_URL.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------------------------
# Authentication (required) - Auth.js v5 + Google, single owner
# ---------------------------------------------------------------------------------------------
# Session-encryption secret and keyed-hash secret for rate-limit buckets.
# Generate:  openssl rand -base64 32
# Changing it signs everybody out.
AUTH_SECRET=replace-with-openssl-rand-base64-32

# OAuth 2.0 Web client from Google Cloud Console (APIs & Services -> Credentials).
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://qr.zeyuyaoy.com/api/auth/callback/google
AUTH_GOOGLE_ID=replace-with-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=replace-with-client-secret

# Comma-separated Google account emails allowed to sign in (case-insensitive). Everyone else is denied.
OWNER_EMAILS=you@example.com

# ---------------------------------------------------------------------------------------------
# Encryption keys (independent of each other; each must be 32 random bytes, base64)
# ---------------------------------------------------------------------------------------------
# Generate EACH with its own run:  openssl rand -base64 32
# Store both in a password manager that does NOT depend on Vercel or GitHub: losing a key makes the
# data it protects unrecoverable.

# Seals Wi-Fi and vCard records before they are written to Redis (AES-256-GCM). Without it those two
# types cannot be saved to the server (they still work locally). Rotating it makes existing sealed
# records unreadable: see docs/DEPLOYMENT.md "Rotating secrets".
DATA_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Encrypts backup snapshots (AES-256-GCM + gzip). Needed for backups, encrypted export and restore.
BACKUP_ENCRYPTION_KEY=replace-with-a-different-openssl-rand-base64-32

# ---------------------------------------------------------------------------------------------
# Scheduled backup (required for the daily Vercel cron)
# ---------------------------------------------------------------------------------------------
# Vercel Cron sends this automatically as "Authorization: Bearer <value>" when the variable exists.
# Generate:  openssl rand -hex 32
CRON_SECRET=replace-with-openssl-rand-hex-32

# Private GitHub repository that stores the encrypted snapshots, as owner/name.
BACKUP_GITHUB_REPO=your-github-user/qr-studio-backups
# Fine-grained personal access token limited to that ONE repository with
# "Contents: Read and write" (Metadata: Read is added automatically). Nothing else.
BACKUP_GITHUB_TOKEN=github_pat_replace_me
# Branch to write to (default: main). The branch must already exist (initialise the repo with a README).
BACKUP_GITHUB_BRANCH=main

# ---------------------------------------------------------------------------------------------
# TEST-ONLY settings. Leave these out of Vercel entirely.
# ---------------------------------------------------------------------------------------------
# WARNING: ENABLE_TEST_AUTH=1 adds a password-less "Test sign-in" button that signs in as the first
# OWNER_EMAILS entry when TEST_AUTH_SECRET matches. The code disables it on ALL Vercel deployments,
# including previews. On other hosts, use it on
# localhost / the automated tests only, never set it on a deployment that holds real data.
#ENABLE_TEST_AUTH=1
#TEST_AUTH_SECRET=replace-with-openssl-rand-hex-16

# Only honoured when NODE_ENV=test (the integration tests set it themselves): redirects every key to a
# throw-away prefix. Do not set it by hand.
#QR_KEY_PREFIX=qr:test:abc123:

# Playwright only: Redis for the E2E run. Must be local; defaults to redis://localhost:6390/5.
#E2E_REDIS_URL=redis://localhost:6390/5

# Optional local QA isolation (never production):
#E2E_PORT=3217
#E2E_DIST_DIR=.next-qa
# Build output override used by local QA. Default is .next.
#NEXT_DIST_DIR=.next-release
# NEXT_PUBLIC_SW_VERSION is generated by next.config.ts, not a secret or required input.
